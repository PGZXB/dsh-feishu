# Dependencies
node_modules/

# Build output (root-level only — `e2e/lib/` is tracked source)
/lib/
/dist/

# Test output
coverage/

# Local development state (isolated DSH home used by feasibility tests)
_dev/
.dev/

# Reference checkouts used during research/development (never part of the package)
_tmp/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Environment / secrets
.env
.env.local
.env.*.local

# Machine-local pnpm store/cache paths
.npmrc

# Container-created pnpm store (the e2e container may drop one in cwd)
.pnpm-store/

# Compiled e2e suite (container-local build output)
e2e/.build/
