{
  // E2E browser code compiles with the DOM lib (page.evaluate callbacks run
  // in the browser). Kept out of the root tsconfig so the DOM globals do not
  // leak into src/tests compilation. Checked by `pnpm run typecheck`'s second
  // pass (`tsc -p e2e/tsconfig.json --noEmit`).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["."]
}
